rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check file type
    function isValidFileType() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('application/pdf');
    }

    // Helper function to check file size (max 10MB)
    function isValidSize() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read: if true; // Everyone can read
      allow write: if false; // Default deny write
    }

    // Images directory
    match /images/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAuthenticated() 
                  && request.auth.uid == userId // User can only write to their directory
                  && request.resource.contentType.matches('image/.*')
                  && isValidSize();
    }

    // PDF documents directory
    match /documents/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAuthenticated()
                  && request.auth.uid == userId // User can only write to their directory
                  && request.resource.contentType == 'application/pdf'
                  && isValidSize();
    }

    // User uploads (both images and PDFs)
    match /uploads/{userId}/{fileName} {
      allow read: if true; // Public read access
      allow write: if isAuthenticated()
                  && request.auth.uid == userId
                  && isValidFileType()
                  && isValidSize();
    }
  }
}